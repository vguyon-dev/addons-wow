<!-- Raccourci clavier : Échap > Options > Raccourcis > Quêtes auto.
     Le jeu charge ce fichier tout seul, sans le citer dans le .toc.
     header= seulement sur le premier raccourci, sinon le jeu avertit « loaded more than once ». -->
<Bindings>
  <Binding name="QUETESAUTO_BASCULER" header="QUETESAUTO" category="ADDONS">
    QuetesAuto_Basculer()
  </Binding>
  <Binding name="QUETESAUTO_REGLAGES" category="ADDONS">
    QuetesAuto_OuvrirReglages()
  </Binding>
</Bindings>
